OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Серверный ключ Exa Search для исследования выбранной территории.
# Никогда не добавляйте его в VITE_* или frontend.
EXA_API_KEY=

# Supabase Edge Worker: включать только после добавления этих OPENAI_* значений
# в Supabase Edge Function Secrets. Повторный анализ кешируется по content hash,
# модели и версии prompt.
AI_ENRICHMENT_ENABLED=false

# Явное согласие на отправку спорного фрагмента новости AI-провайдеру.
GEOLOCATION_AI_ENABLED=false

# Публичный read-only доступ к кешу. Secret key сюда добавлять нельзя.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
